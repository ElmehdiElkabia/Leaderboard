# Copy this file to .env and fill in your 42 OAuth application credentials

# 42 OAuth Configuration
VITE_42_CLIENT_ID=your_client_id_here
VITE_42_CLIENT_SECRET=your_client_secret_here
VITE_42_REDIRECT_URI=http://localhost:8080/
VITE_42_AUTHORIZE_URL=https://api.intra.42.fr/oauth/authorize
VITE_42_TOKEN_URL=https://api.intra.42.fr/oauth/token
VITE_42_API_BASE_URL=https://api.intra.42.fr/v2

# Instructions:
# 1. Go to https://profile.intra.42.fr/oauth/applications
# 2. Create a new application or edit your existing one
# 3. Set the redirect URI to: http://localhost:8080/
# 4. Copy the client ID and client secret and paste them above
# 5. The other URLs should remain as shown above for the 42 API
